{
  "name": "@local/session-graph",
  "version": "1.0.1",
  "type": "module",
  "description": "Interactive directed force graph of the DSH session trajectory, contributed as a Conversation view.",
  "author": {
    "name": "Jinzhu.Zhang",
    "email": "freeheart1977@139.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeheart/dsh-session-graph.git"
  },
  "homepage": "https://github.com/freeheart/dsh-session-graph#readme",
  "bugs": {
    "url": "https://github.com/freeheart/dsh-session-graph/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-client-plugin",
    "session",
    "trajectory",
    "force-directed",
    "graph",
    "visualization"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "SKILL.md",
    "docs/screenshots/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
